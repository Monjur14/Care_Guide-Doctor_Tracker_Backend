# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string (Atlas: mongodb+srv://<user>:<pass>@<cluster>/doctor-tracker)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# Session lifetime in minutes
SESSION_TTL_MINUTES=480

# Comma-separated list of allowed frontend origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (1 on Vercel)
TRUST_PROXY=1

# bcrypt work factor
BCRYPT_ROUNDS=12

# Swagger UI at /api/docs (default: on, except in production). Set to true on Vercel to publish the docs.
# API_DOCS_ENABLED=true

# --- Seed script only (npm run seed) ---
SEED_ADMIN_EMAIL=admin@doctortracker.dev
# At least 12 characters
SEED_ADMIN_PASSWORD=change-me-Strong-Passw0rd
